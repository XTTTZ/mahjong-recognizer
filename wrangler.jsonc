{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mahjong",
  "account_id": "YOUR_CLOUDFLARE_ACCOUNT_ID",
  "main": "apps/worker/index.ts",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "routes": [{ "pattern": "mahjong.avalonxty.site", "custom_domain": true }],
  "upload_source_maps": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "vars": { "INFERENCE_ENABLED": "true", "MODAL_URL": "https://MODAL_WORKSPACE--mahjong-inference-recognizer-api.us-east.modal.run/recognize", "ALLOWED_ORIGINS": "https://mahjong.avalonxty.site", "APP_VERSION": "2026-10-29-scoring-warmup" },
  "ratelimits": [
    { "name": "USER_LIMIT", "namespace_id": "31001", "simple": { "limit": 3, "period": 60 } },
    { "name": "SITE_LIMIT", "namespace_id": "31002", "simple": { "limit": 30, "period": 60 } },
    { "name": "WARM_USER_LIMIT", "namespace_id": "31003", "simple": { "limit": 1, "period": 60 } },
    { "name": "WARM_SITE_LIMIT", "namespace_id": "31004", "simple": { "limit": 6, "period": 60 } }
  ],
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true }, "traces": { "enabled": true, "head_sampling_rate": 0.1 } }
}
