{
  "name": "mahjong-recognizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:web": "vite build",
    "build": "npm run typecheck && npm run build:web",
    "typecheck": "tsc --noEmit && node -e \"const fs=require('fs');if(fs.existsSync('tsconfig.worker.json'))require('child_process').execSync('tsc --noEmit -p tsconfig.worker.json',{stdio:'inherit'})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:types": "wrangler types --include-runtime false --strict-vars false",
    "worker:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "worker:dev": "npm run build:web && wrangler dev",
    "worker:deploy": "npm run build && wrangler deploy",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261013.1",
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.1.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite": "7.2.0",
    "vitest": "5.0.1",
    "wrangler": "4.150.0"
  }
}
